MODERATOR_PASSWORD=replace-with-a-long-password

# CREATE_PASSWORD remains supported for existing deployments.

# Vercel's Upstash integration supplies these in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

PORT=3000

# Local runs always use the ignored JSON test database under data/*.local.json.
# Production Vercel runs use Redis automatically; do not point local runs at it.
RIDDLE_TABLETS_STORAGE=local
